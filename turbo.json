{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "build/**"
      ]
    },

    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },

    "lint": {
      "outputs": []
    },

    "clean": {
      "cache": false
    }
  }
}
